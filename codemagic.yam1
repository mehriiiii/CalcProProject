workflows:
  android-debug:
    name: Android Debug APK
    max_build_duration: 60

    environment:
      java: 17

    scripts:
      - name: Set up local.properties
        script: echo "sdk.dir=$ANDROID_SDK_ROOT" > "$CM_BUILD_DIR/local.properties"

      - name: Build APK
        script: gradle assembleDebug

    artifacts:
      - app/build/outputs/**/*.apk
